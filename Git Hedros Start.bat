@echo off
setlocal
:: ============================================================
:: Git Hedros - Launcher Oficial (Arquivo Único)
:: ============================================================

set PORT=3000
set HOST=127.0.0.1

:: Diretorios base
set "ROOT_DIR=%~dp0"
set "ROOT_DIR=%ROOT_DIR:~0,-1%"
set "HTML=%ROOT_DIR%\Git Hedros.html"
set "SRV_DIR=%TEMP%\git-hedros"
set "SRV_FILE=%SRV_DIR%\server.js"
set "RUN_VBS=%SRV_DIR%\run.vbs"

:: Se ja estiver em execucao, apenas abre o painel no navegador
netstat -ano | findstr %HOST%:%PORT% | findstr LISTENING >nul
if %errorlevel%==0 (
  start "" "%HTML%"
  exit /b
)

:: Localiza executavel do Node.js com caminho completo
set "NODE_CMD="
for /f "delims=" %%i in ('where node.exe 2^>nul') do if not defined NODE_CMD set "NODE_CMD=%%i"
if not defined NODE_CMD (
  if exist "C:\Program Files\nodejs\node.exe" (
    set "NODE_CMD=C:\Program Files\nodejs\node.exe"
  ) else (
    echo [ERRO] Node.js nao foi encontrado no sistema!
    echo Instale o Node.js em https://nodejs.org para rodar o Git Hedros.
    pause
    exit /b 1
  )
)

:: Garante diretorio temporario para o servidor
if not exist "%SRV_DIR%" mkdir "%SRV_DIR%"

:: Extrai o server.js embutido usando certutil nativo do Windows
certutil -decode "%~f0" "%SRV_FILE%" >nul 2>&1

:: Cria o runner VBS para iniciar o Node de forma totalmente invisivel
(
echo Set WshShell = CreateObject^("WScript.Shell"^)
echo WshShell.CurrentDirectory = "%ROOT_DIR%"
echo WshShell.Run """%NODE_CMD%"" """ ^& "%SRV_FILE%" ^& """", 0, False
) > "%RUN_VBS%"

:: Executa o runner em background
wscript.exe "%RUN_VBS%"

:: Aguarda a porta 3000 responder e abre o HTML
powershell -NoProfile -WindowStyle Hidden -Command "for ($i=0; $i -lt 30; $i++) { if (Get-NetTCPConnection -LocalPort 3000 -State Listen -ErrorAction SilentlyContinue) { Start-Process '%HTML%'; break }; Start-Sleep -Milliseconds 300 }"

exit /b

